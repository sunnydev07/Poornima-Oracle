# ==============================================================================
# Poornima Oracle Assistant - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3001
CORS_ORIGIN=https://poornima-oracle.onrender.com

# Number of trusted reverse-proxy hops used to derive the client IP.
# Keep 0 unless a trusted proxy (e.g. Render) is known to overwrite X-Forwarded-For.
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# Primary Vector Database (Pinecone)
# Sign up and retrieve keys at https://app.pinecone.io
# ------------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=poornima-oracle
PINECONE_NAMESPACE=__default__

# ------------------------------------------------------------------------------
# Primary LLM & Embeddings (Google Gemini)
# Get your API key at https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# RAG Retrieval, Caching & Rate Limiting Controls
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=20
FEEDBACK_RATE_LIMIT_MAX=30
FEEDBACK_RATE_LIMIT_WINDOW_MS=900000
# Overall request deadline and maximum gap between streamed tokens (ms).
REQUEST_TIMEOUT_MS=90000
ANSWER_IDLE_TIMEOUT_MS=30000
# Provider streams allowed to run concurrently before returning HTTP 429.
MAX_CONCURRENT_GENERATIONS=5
CACHE_MAX_KEYS=1000
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
RAG_REQUEST_TIMEOUT_MS=15000
RAG_REQUEST_RETRIES=2
QUERY_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# Admin Operations & Notice Ingestion
# ------------------------------------------------------------------------------
# Long random secret required by POST /api/sync-notices and GET /api/test-models.
# Send it as `x-admin-key: <value>` or `Authorization: Bearer <value>`.
ADMIN_API_KEY=generate_a_long_random_secret
NOTICE_SYNC_ENABLED=true
# Cron runs in the server's local time (UTC on Render). "30 0 * * *" = 06:00 IST.
NOTICE_SYNC_CRON=30 0 * * *
# Extract text from linked PDF circulars during ingestion.
ENABLE_PDF_EXTRACTION=true
PDF_CONCURRENCY=2

# ==============================================================================
# Dual-Tier Cloud Fallback Subsystem
# Escalates queries when primary knowledge base has gaps (score < 0.35),
# when Gemini refuses due to lack of info, or during API 429/503 outages.
# ==============================================================================
FALLBACK_ENABLED=true

# ------------------------------------------------------------------------------
# Tier 1 Cloud Fallback: OpenRouter Free API
# Utilizes zero-cost models with native function calling.
# Sign up and generate a free key at https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=https://poornima-oracle.onrender.com
OPENROUTER_APP_NAME=Poornima Oracle Fallback Agent
OPENROUTER_TIMEOUT_MS=12000

# ------------------------------------------------------------------------------
# Tier 2 Cloud Fallback: Ollama Cloud API (Remote / Hosted)
# Connects to remote Ollama cloud instance (zero offline/local dependency).
# Use https://ollama.com or your custom remote cloud Ollama endpoint.
# ------------------------------------------------------------------------------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_CLOUD_MODEL=nemotron-3-nano:30b
OLLAMA_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# Optional Search Engine Providers
# (DuckDuckGo search runs out-of-the-box with zero configuration or keys)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
