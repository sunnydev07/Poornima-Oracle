{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "mcpServers": {
    "sqlite": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "./data/poornima.db"],
      "enabled": false,
      "description": "Direct SQLite access for structured academic and admissions data"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      },
      "enabled": false,
      "description": "GitHub integration for Poornima open-source project repositories"
    },
    "remote-mcp": {
      "url": "https://mcp.poornima.edu.in/sse",
      "transport": "sse",
      "enabled": false,
      "description": "Cloud remote MCP server over HTTP/SSE"
    }
  }
}
