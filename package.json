{
  "name": "poornima-instructor-server",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./styles.css --minify",
    "check": "node --check server.js && node --check sw.js && node --check chat-contract.js && node --check chat-request-owner.js && npm run check:client",
    "check:client": "node scripts/check-client.js",
    "check:css": "npm run build:css && git diff --exit-code -- styles.css",
    "dev": "node server.js",
    "start": "node server.js",
    "start:prod": "pm2 start server.js --name poornima-oracle",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "@pinecone-database/pinecone": "^6.1.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "node-cache": "^5.1.2",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
